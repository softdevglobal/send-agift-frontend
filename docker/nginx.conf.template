# Serves the built single-page app and forwards API calls to the Go server.
# ${API_UPSTREAM} is filled in from the environment when the container starts.

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # Review photos and videos upload straight to S3, so API bodies stay small.
    client_max_body_size 10m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # API, health check and build version all live on the Go server.
    location ~ ^/(api/|health$|version$) {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Live prize updates stream as server-sent events: pass each event
        # through as it arrives and keep the connection open.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }

    # Vite fingerprints built files, so they can be cached for good.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Every other path is a client-side route: serve the app shell, and never
    # cache it, so a deploy shows up on the next load.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
